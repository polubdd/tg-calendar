# Скопируйте в .env и заполните. Реальный .env в git не попадает.

# --- Календарь ---
CALENDAR_TZ=Europe/Moscow
DB_PATH=data/calendar.db
HOST=127.0.0.1
PORT=8000
# Секрет в адресе подписки .ics; пусто — сгенерируется при первом запуске
ICS_TOKEN=

# --- Локальная модель (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Контекст задаётся явно: по умолчанию Ollama берёт меньше и молча обрезает начало промпта
NUM_CTX=8192
LLM_TIMEOUT=180
LLM_MAX_ATTEMPTS=3

# --- Бюджет контекста для переписки ---
RESERVE_OUTPUT_TOKENS=1024
MAX_WINDOW_TOKENS=2500
MAX_WINDOW_CHARS=6000
MAX_MESSAGE_CHARS=600
WINDOW_OVERLAP=2
MAX_MESSAGES_PER_RUN=300

# --- Telegram ---
# Токен от @BotFather (вида 123456:ABC...). Не публикуйте его.
TELEGRAM_BOT_TOKEN=
# Ваш числовой id в Telegram (бот покажет его на /start). Через запятую, если владельцев несколько.
ALLOWED_OWNER_IDS=
# Чат обрабатывается, когда переписка затихла на столько секунд или набралось столько сообщений
FLUSH_IDLE_SECONDS=90
FLUSH_MAX_MESSAGES=40
# Необработанный текст переписки удаляется через столько часов, даже если модель так и не запустили
PENDING_TTL_HOURS=48
# Ниже этой уверенности событие становится черновиком на подтверждение
AUTO_CONFIRM_THRESHOLD=0.8
NOTIFY_AUTO_ADDED=true
# Лимиты отправки (Telegram: ~30 сообщений/с на бота, 1/с в один чат)
TG_GLOBAL_RATE=25
TG_PER_CHAT_RATE=1
TG_CONCURRENCY=4
TG_MAX_ATTEMPTS=5
